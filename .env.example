# Database
DATABASE_URL="postgresql://user:password@localhost:5432/coloring_app"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AWS S3
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="coloring-app-bucket"
AWS_S3_REGION="us-east-1"

# SendGrid Email
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="orders@rangpankh.co.in"

# Admin Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional: Local file storage (alternative to S3)
USE_LOCAL_STORAGE="true"
LOCAL_STORAGE_PATH="./public/uploads"
